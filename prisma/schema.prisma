// prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Gerenciamento seguro via Transaction Pooler do Supabase
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS (REGRAS DE SEGURANÇA E CATEGORIAS DA PLATAFORMA)
// =============================================================================

enum Role {
  ADMIN_RPM // Administrador global do ecossistema RPMTruck
  GESTOR_EMPRESA // Dono / Gestor da Transportadora Cliente
  OPERADOR // Operador logístico interno da transportadora
  VISUALIZADOR // Usuário com permissão estrita de leitura
}

enum PlanoTipo {
  PREVIEW
  ESSENCIAL
  AVANCADO
  ENTERPRISE
}

enum StatusEmpresa {
  ATIVO
  INADIMPLENTE
  INATIVO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusReset {
  PENDENTE
  APROVADO
  CONCLUIDO
  REJEITADO
}

enum EventoSegurancaTipo {
  LOGIN_SUCESSO
  LOGIN_FALHA
  LOGOUT
  RATE_LIMIT
  BOT_REJEITADO
  SESSAO_REVOGADA
}

enum StatusFatura {
  PENDENTE
  PAGO
}

enum StatusContaPagar {
  PENDENTE
  PAGO
  CANCELADO
}

enum CategoriaContaPagar {
  COMBUSTIVEL
  MANUTENCAO
  PEDAGIO
  ALIMENTACAO
  DIARIA_MOTORISTA
  SEGURO
  SALARIO
  COMISSAO_TRANSPORTE
  OUTROS
}

enum OrigemLeituraBoleto {
  MANUAL
  PDF_TEXTO
  CODIGO_BARRAS
}

enum TipoSolicitacaoAssinatura {
  ALTERAR_PLANO
  ALTERAR_COTAS
  NEGOCIAR_PAGAMENTO
}

enum StatusSolicitacaoAssinatura {
  PENDENTE
  APROVADA
  REJEITADA
}

enum StatusManutencao {
  PENDENTE
  CONCLUIDA
  CANCELADA
  NAO_REALIZADA
}

enum CategoriaCusto {
  COMBUSTIVEL
  MANUTENCAO
  PEDAGIO
  ALIMENTACAO
  DIARIA_MOTORISTA
  SEGURO
  SALARIO
  COMISSAO_TRANSPORTE
  OUTROS
}

enum StatusCusto {
  PAGO
  PENDENTE
}

enum TipoRelatorioArquivo {
  CUSTOS
  OPERACIONAL
  PERSONALIZADO
}

enum StatusRelatorioArquivo {
  PRONTO_DOWNLOAD
  DOWNLOAD_REGISTRADO
  CONFIRMADO_GESTOR
  DADOS_PURGADOS
  ARQUIVO_REMOVIDO
}

enum AlertaSeveridade {
  INFORMACAO
  AVISO
  CRITICO
}

enum CategoriaTicketSuporte {
  SUPORTE_TECNICO
  REPORTAR_ERRO
  DUVIDA_OPERACIONAL
  SOLICITACAO
  FINANCEIRO
}

enum StatusTicketSuporte {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

enum PrioridadeTicketSuporte {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum TipoMensagemSuporte {
  USUARIO
  SISTEMA
}

// =============================================================================
// MODELOS / TABELAS DO BANCO DE DADOS (MULTI-TENANT INFRAS)
// =============================================================================

model SolicitacaoAcesso {
  id            String            @id @default(uuid())
  empresa       String
  responsavel   String
  email         String            @unique
  whatsapp      String?
  veiculos      Int // Frota base definida e travada pelo plano
  plano         PlanoTipo
  mensagem      String?
  contatoPref   String            @default("email") // "email" ou "whatsapp"
  status        StatusSolicitacao @default(PENDENTE)
  criado_em     DateTime          @default(now())
  atualizado_em DateTime          @updatedAt

  @@index([status, criado_em])
  @@map("solicitacoes_acesso")
}

model ResetSenha {
  id              String      @id @default(uuid())
  email           String
  status          StatusReset @default(PENDENTE)
  chave           String? // Coluna legada; novas chaves nunca são armazenadas em texto puro.
  token_hash      String?
  token_expira_em DateTime?
  token_usado_em  DateTime?
  criado_em       DateTime    @default(now())
  atualizado_em   DateTime    @updatedAt

  @@index([email, status])
  @@index([token_expira_em])
  @@map("resets_senha")
}

model Empresa {
  id                   String        @id @default(uuid())
  nome                 String
  cnpj                 String?       @unique
  cnpjHash             String?       @unique @map("cnpj_hash")
  email                String        @unique
  nome_contato         String?
  telefone             String?
  status               StatusEmpresa @default(ATIVO)
  plano                PlanoTipo     @default(ESSENCIAL)
  total_pago_historico String        @default("0,00")
  status_motivo        String?
  status_alterado_em   DateTime?

  status_alterado_por_id String?
  status_alterado_por    Usuario? @relation("EmpresaStatusAlteradoPor", fields: [status_alterado_por_id], references: [id], onDelete: SetNull)

  // Modificadores de Escala
  usuarios_adicionais Int @default(0)
  veiculos_adicionais Int @default(0)

  portal_financeiro_nome String? @map("portal_financeiro_nome")
  portal_financeiro_url  String? @map("portal_financeiro_url")

  // Módulos ativos
  modulos String[] @default(["FROTA", "GESTAO", "CONTAS_PAGAR", "NOTIFICACOES"])

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  // Relacionamentos (Isolamento Multitenant)
  usuarios                Usuario[]
  veiculos_frota          Veiculo[]
  motoristas              Motorista[]
  localizacoes            Localizacao[]
  historicos_veiculos     HistoricoVeiculo[]
  custos                  Custo[]
  notificacoes            Notificacao[]
  faturas                 Fatura[]
  relatorios_arquivados   RelatorioArquivo[]
  movimentacoes_container MovimentacaoContainerPermanente[]
  containers              Container[]
  tarefas                 Tarefa[]
  leituras_quilometragem  LeituraQuilometragem[]
  sessoes                 SessaoUsuario[]
  eventos_seguranca       EventoSeguranca[]
  solicitacoes_assinatura SolicitacaoAssinatura[]
  contas_pagar            ContaPagar[]
  conversas_suporte       ConversaSuporte[]

  @@map("empresas")
}

model Usuario {
  id                      String    @id @default(uuid())
  nome                    String
  email                   String    @unique
  senha_hash              String // Hash de segurança (bcrypt)
  role                    Role      @default(GESTOR_EMPRESA)
  acessoDashboardGeral    Boolean   @default(false) @map("acesso_dashboard_geral")
  sessaoVersao            Int       @default(0) @map("sessao_versao")
  exigeTrocaSenha         Boolean   @default(false) @map("exige_troca_senha")
  senhaTemporariaExpiraEm DateTime? @map("senha_temporaria_expira_em")
  senhaAlteradaEm         DateTime  @default(now()) @map("senha_alterada_em")

  // Se for nulo, indica que o usuário é da equipe interna RPMTruck (Geral Admin)
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  empresas_status_alterados         Empresa[]               @relation("EmpresaStatusAlteradoPor")
  relatorios_criados                RelatorioArquivo[]      @relation("RelatoriosCriados")
  relatorios_baixados               RelatorioArquivo[]      @relation("RelatoriosBaixados")
  relatorios_confirmados            RelatorioArquivo[]      @relation("RelatoriosConfirmados")
  notificacoes                      Notificacao[]           @relation("NotificacoesUsuario")
  tarefas_criadas                   Tarefa[]                @relation("TarefasCriadas")
  tarefas_atribuidas                Tarefa[]                @relation("TarefasResponsavel")
  sessoes                           SessaoUsuario[]
  eventos_seguranca                 EventoSeguranca[]
  solicitacoes_assinatura_criadas   SolicitacaoAssinatura[] @relation("SolicitacaoAssinaturaCriadaPor")
  solicitacoes_assinatura_decididas SolicitacaoAssinatura[] @relation("SolicitacaoAssinaturaDecididaPor")
  faturas_baixadas                  Fatura[]                @relation("FaturasBaixadasPor")
  contas_pagar_criadas              ContaPagar[]            @relation("ContasPagarCriadasPor")
  contas_pagar_baixadas             ContaPagar[]            @relation("ContasPagarBaixadasPor")
  mensagens_suporte                 MensagemSuporte[]
  alertas_criados                   AlertaSistema[]         @relation("AlertasCriados")
  alertas_destinados                AlertaSistema[]         @relation("AlertasDestinados")
  alertas_lidos                     AlertaLeitura[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, role])
  @@map("usuarios")
}

model Localizacao {
  id         String @id @default(uuid())
  nome       String // Ex: 'Pátio Santos - SP', 'Garagem Central'
  cidadeUF   String // Ex: 'Santos / SP'
  capacidade Int    @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiculos Veiculo[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, nome])
  @@map("localizacoes")
}

model Veiculo {
  id                    String @id @default(uuid())
  modelo                String
  placa                 String @unique
  tipo                  String
  ano                   Int?
  quilometragem         Float  @default(0.0)
  status                String @default("OPERACIONAL") // OPERACIONAL, OFICINA, INATIVO
  diasAntecedenciaNotif Int    @default(7)

  // Localização / Base (Opcional)
  localizacaoId String?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  // Empresa (Segurança Multitenant)
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Relações
  motoristas             Motorista[]
  historicos             HistoricoVeiculo[]
  custos                 Custo[]
  notificacoes           Notificacao[]
  containers             Container[]
  leituras_quilometragem LeituraQuilometragem[]
  contas_pagar           ContaPagar[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, status])
  @@map("veiculos")
}

model Motorista {
  id        String   @id @default(uuid())
  nome      String
  cnh       String // Número da CNH
  categoria String // C, D, E, etc
  validade  DateTime
  status    String   @default("DISPONIVEL") // DISPONIVEL, EM_ROTA, ALERTA, FERIAS
  cpf       String?
  rg        String?
  cpfHash   String?  @map("cpf_hash")
  cnhHash   String?  @map("cnh_hash")
  foto_url  String?

  // Relação com a Empresa
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Relacionamento opcional com Veículo
  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  custos     Custo[]
  containers Container[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@unique([empresaId, cpf])
  @@unique([empresaId, cnh])
  @@unique([empresaId, cpfHash])
  @@unique([empresaId, cnhHash])
  @@index([empresaId, validade])
  @@map("motoristas")
}

model HistoricoVeiculo {
  id                 String           @id @default(uuid())
  data_agendada      DateTime // Data agendada da manutenção
  data_conclusao     DateTime? // Data real em que foi realizada
  tipo               String // 'PREVENTIVA', 'CORRETIVA', 'PNEUS', 'OLEO'
  descricao          String?
  pecas_substituidas String?
  custo              Float            @default(0.0)
  km_atual           Float
  status             StatusManutencao @default(PENDENTE)
  origem             String           @default("FUTURA") // 'FUTURA' ou 'ADMINISTRATIVA'

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: Restrict)

  contaPagar ContaPagar?

  criado_em DateTime @default(now())

  @@index([empresaId, status, data_agendada])
  @@index([empresaId, data_agendada])
  @@index([veiculoId, data_agendada])
  @@index([relatorioArquivoId])
  @@map("historicos_veiculo")
}

model LeituraQuilometragem {
  id            String   @id @default(uuid())
  quilometragem Float
  registrada_em DateTime @default(now())
  origem        String   @default("ATUALIZACAO_VEICULO")

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criado_em DateTime @default(now())

  @@index([empresaId, registrada_em])
  @@index([veiculoId, registrada_em])
  @@map("leituras_quilometragem")
}

model Custo {
  id             String         @id @default(uuid())
  data           DateTime // Data do lançamento
  ano            Int // Ex: 2026
  mesIndex       Int // 0 (Jan) a 11 (Dez)
  semanaIndex    Int // 1 a 4
  categoria      CategoriaCusto
  descricao      String
  valor          Float          @default(0.0)
  formaPagamento String         @default("CARTÃO CORPORATIVO")
  status         StatusCusto    @default(PAGO)

  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  motoristaId String?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: Restrict)

  contaPagarId String?     @unique @map("conta_pagar_id")
  contaPagar   ContaPagar? @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)

  containerId String?    @unique @map("container_id")
  container   Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, data])
  @@index([veiculoId, data])
  @@index([relatorioArquivoId])
  @@index([empresaId, categoria, data])
  @@map("custos")
}

// 🔔 SISTEMA GLOBAL DE NOTIFICAÇÕES (Multi-módulo)
model Notificacao {
  id       String  @id @default(uuid())
  modulo   String // Ex: 'FROTA', 'MOTORISTAS', 'CUSTOS'
  titulo   String // Ex: 'Aviso Módulo Frota - Manutenção Pendente'
  mensagem String // Ex: 'Veículo VOLVO FH 540 (ABC-1234) atingiu a data de revisão.'
  lida     Boolean @default(false)

  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarioId String?
  usuario   Usuario? @relation("NotificacoesUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  tarefaId String?
  tarefa   Tarefa? @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  criado_em DateTime @default(now())

  @@index([usuarioId, lida, criado_em])
  @@index([empresaId, lida, criado_em])
  @@map("notificacoes")
}

model ConversaSuporte {
  id                 String                  @id @default(uuid())
  protocolo          String                  @unique
  assunto            String
  categoria          CategoriaTicketSuporte
  status             StatusTicketSuporte     @default(ABERTO)
  prioridade         PrioridadeTicketSuporte @default(NORMAL)
  cobravelExtra      Boolean                 @default(false) @map("cobravel_extra")
  franquiaNoMomento  Int                     @map("franquia_no_momento")
  ordemNaCompetencia Int                     @map("ordem_na_competencia")
  competencia        DateTime                @db.Date
  primeiraRespostaEm DateTime?               @map("primeira_resposta_em")
  encerradoEm        DateTime?               @map("encerrado_em")

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  mensagens MensagemSuporte[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, status, atualizado_em])
  @@index([empresaId, competencia])
  @@index([atualizado_em])
  @@map("conversas_suporte")
}

model MensagemSuporte {
  id         String              @id @default(uuid())
  conteudo   String
  tipo       TipoMensagemSuporte @default(USUARIO)
  automatica Boolean             @default(false)
  lida_em    DateTime?

  conversaId String
  conversa   ConversaSuporte @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  autorId String?
  autor   Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  criado_em DateTime @default(now())

  @@index([conversaId, criado_em])
  @@index([conversaId, lida_em])
  @@map("mensagens_suporte")
}

model AlertaSistema {
  id         String           @id @default(uuid())
  titulo     String
  mensagem   String
  severidade AlertaSeveridade @default(INFORMACAO)
  ativo      Boolean          @default(true)
  inicio_em  DateTime         @default(now())
  fim_em     DateTime?

  destinatarioId String?
  destinatario   Usuario? @relation("AlertasDestinados", fields: [destinatarioId], references: [id], onDelete: Cascade)

  criadoPorId String
  criadoPor   Usuario @relation("AlertasCriados", fields: [criadoPorId], references: [id], onDelete: Restrict)

  leituras AlertaLeitura[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([ativo, inicio_em, fim_em])
  @@index([destinatarioId, ativo, inicio_em])
  @@map("alertas_sistema")
}

model AlertaLeitura {
  alertaId  String
  alerta    AlertaSistema @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lido_em   DateTime      @default(now())

  @@id([alertaId, usuarioId])
  @@index([usuarioId, lido_em])
  @@map("alertas_leituras")
}

model Tarefa {
  id         String    @id @default(uuid())
  titulo     String
  descricao  String?
  prazo      DateTime?
  prioridade String    @default("MEDIA")
  status     String    @default("PENDENTE")
  modulo     String?
  origem_id  String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadorId String
  criador   Usuario @relation("TarefasCriadas", fields: [criadorId], references: [id], onDelete: Restrict)

  responsavelId String
  responsavel   Usuario @relation("TarefasResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  notificacoes Notificacao[]

  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt
  concluido_em  DateTime?

  @@index([empresaId, status, prazo])
  @@index([responsavelId, status, prazo])
  @@map("tarefas")
}

model Container {
  id                  String   @id @default(uuid())
  data                DateTime
  codigo              String
  tipo                String
  terminal_inicio     String
  terminal_fim        String
  frete               Float    @default(0)
  comissao            Float    @default(0)
  percentual_comissao Float    @default(10)
  comissao_ativa       Boolean  @default(true)
  status              String   @default("AGENDADO")
  observacoes         String?
  itens_conteudo      Json?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  motoristaId String?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)

  custoComissao Custo?

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: Restrict)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@unique([empresaId, codigo, data])
  @@index([empresaId, data, status])
  @@index([relatorioArquivoId])
  @@map("containers")
}

model MovimentacaoContainerPermanente {
  id                  String   @id @default(uuid())
  container_origem_id String
  versao              Int      @default(1)
  registro_atual      Boolean  @default(true)
  codigo_container    String
  terminal_origem     String
  terminal_destino    String
  data_operacao       DateTime

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: SetNull)

  checksum_arquivo     String?
  arquivado_em         DateTime?
  detalhes_purgados_em DateTime?
  criado_em            DateTime  @default(now())
  atualizado_em        DateTime  @updatedAt

  @@index([empresaId, codigo_container])
  @@index([empresaId, data_operacao])
  @@index([relatorioArquivoId])
  @@unique([container_origem_id, versao], map: "mov_container_origem_versao_key")
  @@map("movimentacoes_container_permanentes")
}

model Fatura {
  id             String       @id @default(uuid())
  mes            String // Ex: 'Jun'
  ano            Int // Ex: 2026
  tipo           String // 'IMPLEMENTACAO' ou 'MENSALIDADE'
  valor          Float // Controlado numericamente para permitir overrides no Admin
  status         StatusFatura @default(PENDENTE)
  comprovanteUrl String? // Bucket Privado Supabase Storage
  pago_em        DateTime?
  pago_por_id    String?
  pago_por       Usuario?     @relation("FaturasBaixadasPor", fields: [pago_por_id], references: [id], onDelete: SetNull)

  empresaId               String
  empresa                 Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  solicitacoes_negociacao SolicitacaoAssinatura[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, criado_em])
  @@index([status, criado_em])
  @@index([pago_por_id])
  @@map("faturas")
}

model ContaPagar {
  id                  String               @id @default(uuid())
  descricao           String
  fornecedor          String?
  vencimento          DateTime             @db.Date
  valor               Decimal              @db.Decimal(12, 2)
  status              StatusContaPagar     @default(PENDENTE)
  linha_digitavel     String?
  origem_leitura      OrigemLeituraBoleto  @default(MANUAL)
  categoria           CategoriaContaPagar?
  boleto_path         String?
  boleto_nome         String?
  boleto_mime         String?
  boleto_tamanho      Int?
  comprovante_path    String?
  comprovante_nome    String?
  comprovante_mime    String?
  comprovante_tamanho Int?
  pago_em             DateTime?
  criado_em           DateTime             @default(now())
  atualizado_em       DateTime             @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadoPorId String?  @map("criado_por_id")
  criadoPor   Usuario? @relation("ContasPagarCriadasPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  pagoPorId String?  @map("pago_por_id")
  pagoPor   Usuario? @relation("ContasPagarBaixadasPor", fields: [pagoPorId], references: [id], onDelete: SetNull)

  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  historicoVeiculoId String?           @unique @map("historico_veiculo_id")
  historicoVeiculo   HistoricoVeiculo? @relation(fields: [historicoVeiculoId], references: [id], onDelete: SetNull)

  custo Custo?

  @@index([empresaId, status, vencimento])
  @@index([empresaId, criado_em])
  @@index([criadoPorId])
  @@index([pagoPorId])
  @@index([empresaId, categoria, vencimento])
  @@index([veiculoId])
  @@map("contas_pagar")
}

model PlanoComercial {
  plano                 PlanoTipo @id
  precoBase             Decimal   @map("preco_base") @db.Decimal(12, 2)
  taxaImplantacao       Decimal   @map("taxa_implantacao") @db.Decimal(12, 2)
  precoUsuarioAdicional Decimal   @map("preco_usuario_adicional") @db.Decimal(12, 2)
  precoVeiculoAdicional Decimal   @map("preco_veiculo_adicional") @db.Decimal(12, 2)
  ativo                 Boolean   @default(true)
  visivelLanding        Boolean   @default(true) @map("visivel_landing")
  versao                Int       @default(1)
  criado_em             DateTime  @default(now())
  atualizado_em         DateTime  @updatedAt

  @@map("planos_comerciais")
}

model SolicitacaoAssinatura {
  id                            String                      @id @default(uuid())
  tipo                          TipoSolicitacaoAssinatura
  status                        StatusSolicitacaoAssinatura @default(PENDENTE)
  planoAtual                    PlanoTipo                   @map("plano_atual")
  planoSolicitado               PlanoTipo?                  @map("plano_solicitado")
  usuariosAdicionaisAtuais      Int                         @map("usuarios_adicionais_atuais")
  usuariosAdicionaisSolicitados Int                         @map("usuarios_adicionais_solicitados")
  veiculosAdicionaisAtuais      Int                         @map("veiculos_adicionais_atuais")
  veiculosAdicionaisSolicitados Int                         @map("veiculos_adicionais_solicitados")
  mensalidadeAtual              Decimal                     @map("mensalidade_atual") @db.Decimal(12, 2)
  mensalidadeProposta           Decimal                     @map("mensalidade_proposta") @db.Decimal(12, 2)
  catalogoVersao                Int                         @map("catalogo_versao")
  impacto                       Json?
  mensagem                      String?
  respostaAdmin                 String?                     @map("resposta_admin")
  criadoPorNome                 String                      @map("criado_por_nome")
  decididoPorNome               String?                     @map("decidido_por_nome")
  criado_em                     DateTime                    @default(now())
  atualizado_em                 DateTime                    @updatedAt
  decidido_em                   DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadoPorId String?  @map("criado_por_id")
  criadoPor   Usuario? @relation("SolicitacaoAssinaturaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  decididoPorId String?  @map("decidido_por_id")
  decididoPor   Usuario? @relation("SolicitacaoAssinaturaDecididaPor", fields: [decididoPorId], references: [id], onDelete: SetNull)

  faturaId String? @map("fatura_id")
  fatura   Fatura? @relation(fields: [faturaId], references: [id], onDelete: Restrict)

  @@index([empresaId, criado_em])
  @@index([status, criado_em])
  @@index([faturaId])
  @@map("solicitacoes_assinatura")
}

model RelatorioArquivo {
  id                     String                 @id @default(uuid())
  nome_arquivo           String
  caminho_storage        String                 @unique
  bucket                 String
  mime_type              String
  tamanho_bytes          Int
  checksum_sha256        String
  periodo_inicio         DateTime
  periodo_fim            DateTime
  tipo                   TipoRelatorioArquivo
  status                 StatusRelatorioArquivo @default(PRONTO_DOWNLOAD)
  gerado_automaticamente Boolean                @default(false)
  resumo_registros       Json?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  criadoPorId String?
  criadoPor   Usuario? @relation("RelatoriosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  baixadoPorId String?
  baixadoPor   Usuario?  @relation("RelatoriosBaixados", fields: [baixadoPorId], references: [id], onDelete: SetNull)
  baixado_em   DateTime?

  confirmadoPorId String?
  confirmadoPor   Usuario?  @relation("RelatoriosConfirmados", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  confirmado_em   DateTime?

  dados_purgados_em       DateTime?
  arquivo_removido_em     DateTime?
  movimentacoes_container MovimentacaoContainerPermanente[]
  containers_arquivados   Container[]
  custos_arquivados       Custo[]
  manutencoes_arquivadas  HistoricoVeiculo[]

  criado_em DateTime @default(now())

  @@index([empresaId, criado_em])
  @@index([empresaId, periodo_inicio, periodo_fim])
  @@map("relatorios_arquivados")
}

model RateLimit {
  chaveHash    String   @id @map("chave_hash")
  contador     Int
  janelaInicio DateTime @map("janela_inicio")
  expiraEm     DateTime @map("expira_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([expiraEm])
  @@map("rate_limits")
}

model AuditoriaLog {
  id              String   @id @default(uuid())
  tabela          String
  acao            String
  registroId      String?  @map("registro_id")
  empresaId       String?  @map("empresa_id")
  usuarioId       String?  @map("usuario_id")
  dadosAnteriores Json?    @map("dados_anteriores")
  dadosNovos      Json?    @map("dados_novos")
  origem          String   @default("DATABASE")
  criadoEm        DateTime @default(now()) @map("criado_em")

  @@index([empresaId, criadoEm])
  @@index([tabela, registroId, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("auditoria_logs")
}

model ExclusaoEmpresaJob {
  id              String    @id @default(uuid())
  empresaId       String    @map("empresa_id")
  solicitadoPorId String    @map("solicitado_por_id")
  status          String    @default("PREPARADO")
  arquivos        Json
  erro            String?
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")
  concluidoEm     DateTime? @map("concluido_em")

  @@index([status, atualizadoEm])
  @@index([empresaId, criadoEm])
  @@map("exclusoes_empresa_jobs")
}

model SessaoUsuario {
  id              String    @id @default(uuid())
  usuarioId       String    @map("usuario_id")
  empresaId       String?   @map("empresa_id")
  ipHash          String?   @map("ip_hash")
  userAgent       String?   @map("user_agent")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  ultimaAtividade DateTime  @default(now()) @map("ultima_atividade")
  expiraEm        DateTime  @map("expira_em")
  revogadaEm      DateTime? @map("revogada_em")

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, expiraEm])
  @@index([empresaId, ultimaAtividade])
  @@index([ultimaAtividade, revogadaEm])
  @@map("sessoes_usuario")
}

model EventoSeguranca {
  id        String              @id @default(uuid())
  tipo      EventoSegurancaTipo
  usuarioId String?             @map("usuario_id")
  empresaId String?             @map("empresa_id")
  emailHash String?             @map("email_hash")
  ipHash    String?             @map("ip_hash")
  userAgent String?             @map("user_agent")
  contexto  Json?
  criadoEm  DateTime            @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([tipo, criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([empresaId, criadoEm])
  @@index([ipHash, criadoEm])
  @@map("eventos_seguranca")
}
