// prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Gerenciamento seguro via Transaction Pooler do Supabase
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS (REGRAS DE SEGURANÇA E CATEGORIAS DA PLATAFORMA)
// =============================================================================

enum Role {
  ADMIN_RPM // Administrador global do ecossistema RPMTruck
  GESTOR_EMPRESA // Dono / Gestor da Transportadora Cliente
  OPERADOR // Operador logístico interno da transportadora
  VISUALIZADOR // Usuário com permissão estrita de leitura
}

enum PlanoTipo {
  PREVIEW
  ESSENCIAL
  AVANCADO
  ENTERPRISE
}

enum StatusEmpresa {
  ATIVO
  INADIMPLENTE
  INATIVO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusReset {
  PENDENTE
  APROVADO
  CONCLUIDO
  REJEITADO
}

enum EventoSegurancaTipo {
  LOGIN_SUCESSO
  LOGIN_FALHA
  LOGOUT
  RATE_LIMIT
  BOT_REJEITADO
  SESSAO_REVOGADA
}

enum StatusFatura {
  PENDENTE
  PAGO
}

enum StatusManutencao {
  PENDENTE
  CONCLUIDA
  CANCELADA
  NAO_REALIZADA
}

enum CategoriaCusto {
  COMBUSTIVEL
  MANUTENCAO
  PEDAGIO
  ALIMENTACAO
  DIARIA_MOTORISTA
  SEGURO
  OUTROS
}

enum StatusCusto {
  PAGO
  PENDENTE
}

enum TipoRelatorioArquivo {
  CUSTOS
  OPERACIONAL
  PERSONALIZADO
}

enum StatusRelatorioArquivo {
  PRONTO_DOWNLOAD
  DOWNLOAD_REGISTRADO
  CONFIRMADO_GESTOR
  DADOS_PURGADOS
  ARQUIVO_REMOVIDO
}

// =============================================================================
// MODELOS / TABELAS DO BANCO DE DADOS (MULTI-TENANT INFRAS)
// =============================================================================

model SolicitacaoAcesso {
  id            String            @id @default(uuid())
  empresa       String
  responsavel   String
  email         String            @unique
  whatsapp      String?
  veiculos      Int // Frota base definida e travada pelo plano
  plano         PlanoTipo
  mensagem      String?
  contatoPref   String            @default("email") // "email" ou "whatsapp"
  status        StatusSolicitacao @default(PENDENTE)
  criado_em     DateTime          @default(now())
  atualizado_em DateTime          @updatedAt

  @@index([status, criado_em])
  @@map("solicitacoes_acesso")
}

model ResetSenha {
  id              String      @id @default(uuid())
  email           String
  status          StatusReset @default(PENDENTE)
  chave           String? // Coluna legada; novas chaves nunca são armazenadas em texto puro.
  token_hash      String?
  token_expira_em DateTime?
  token_usado_em  DateTime?
  criado_em       DateTime    @default(now())
  atualizado_em   DateTime    @updatedAt

  @@index([email, status])
  @@index([token_expira_em])
  @@map("resets_senha")
}

model Empresa {
  id                   String        @id @default(uuid())
  nome                 String
  cnpj                 String?       @unique
  cnpjHash             String?       @unique @map("cnpj_hash")
  email                String        @unique
  nome_contato         String?
  telefone             String?
  status               StatusEmpresa @default(ATIVO)
  plano                PlanoTipo     @default(ESSENCIAL)
  total_pago_historico String        @default("0,00")
  status_motivo        String?
  status_alterado_em   DateTime?

  status_alterado_por_id String?
  status_alterado_por    Usuario? @relation("EmpresaStatusAlteradoPor", fields: [status_alterado_por_id], references: [id], onDelete: SetNull)

  // Modificadores de Escala
  usuarios_adicionais Int @default(0)
  veiculos_adicionais Int @default(0)

  // Módulos ativos
  modulos String[] @default(["FROTA", "GESTAO", "NOTIFICACOES"])

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  // Relacionamentos (Isolamento Multitenant)
  usuarios                Usuario[]
  veiculos_frota          Veiculo[]
  motoristas              Motorista[]
  localizacoes            Localizacao[]
  historicos_veiculos     HistoricoVeiculo[]
  custos                  Custo[]
  notificacoes            Notificacao[]
  faturas                 Fatura[]
  relatorios_arquivados   RelatorioArquivo[]
  movimentacoes_container MovimentacaoContainerPermanente[]
  containers              Container[]
  tarefas                 Tarefa[]
  leituras_quilometragem  LeituraQuilometragem[]
  sessoes                 SessaoUsuario[]
  eventos_seguranca       EventoSeguranca[]

  @@map("empresas")
}

model Usuario {
  id                   String  @id @default(uuid())
  nome                 String
  email                String  @unique
  senha_hash           String // Hash de segurança (bcrypt)
  role                 Role    @default(GESTOR_EMPRESA)
  acessoDashboardGeral Boolean @default(false) @map("acesso_dashboard_geral")
  sessaoVersao         Int     @default(0) @map("sessao_versao")

  // Se for nulo, indica que o usuário é da equipe interna RPMTruck (Geral Admin)
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  empresas_status_alterados Empresa[]          @relation("EmpresaStatusAlteradoPor")
  relatorios_criados        RelatorioArquivo[] @relation("RelatoriosCriados")
  relatorios_baixados       RelatorioArquivo[] @relation("RelatoriosBaixados")
  relatorios_confirmados    RelatorioArquivo[] @relation("RelatoriosConfirmados")
  notificacoes              Notificacao[]      @relation("NotificacoesUsuario")
  tarefas_criadas           Tarefa[]           @relation("TarefasCriadas")
  tarefas_atribuidas        Tarefa[]           @relation("TarefasResponsavel")
  sessoes                   SessaoUsuario[]
  eventos_seguranca         EventoSeguranca[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, role])
  @@map("usuarios")
}

model Localizacao {
  id         String @id @default(uuid())
  nome       String // Ex: 'Pátio Santos - SP', 'Garagem Central'
  cidadeUF   String // Ex: 'Santos / SP'
  capacidade Int    @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiculos Veiculo[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, nome])
  @@map("localizacoes")
}

model Veiculo {
  id                    String @id @default(uuid())
  modelo                String
  placa                 String @unique
  tipo                  String
  ano                   Int?
  quilometragem         Float  @default(0.0)
  status                String @default("OPERACIONAL") // OPERACIONAL, OFICINA, INATIVO
  diasAntecedenciaNotif Int    @default(7)

  // Localização / Base (Opcional)
  localizacaoId String?
  localizacao   Localizacao? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)

  // Empresa (Segurança Multitenant)
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Relações
  motoristas             Motorista[]
  historicos             HistoricoVeiculo[]
  custos                 Custo[]
  notificacoes           Notificacao[]
  containers             Container[]
  leituras_quilometragem LeituraQuilometragem[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, status])
  @@map("veiculos")
}

model Motorista {
  id        String   @id @default(uuid())
  nome      String
  cnh       String // Número da CNH
  categoria String // C, D, E, etc
  validade  DateTime
  status    String   @default("DISPONIVEL") // DISPONIVEL, EM_ROTA, ALERTA, FERIAS
  cpf       String?
  rg        String?
  cpfHash   String?  @map("cpf_hash")
  cnhHash   String?  @map("cnh_hash")
  foto_url  String?

  // Relação com a Empresa
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Relacionamento opcional com Veículo
  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  custos     Custo[]
  containers Container[]

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@unique([empresaId, cpf])
  @@unique([empresaId, cnh])
  @@unique([empresaId, cpfHash])
  @@unique([empresaId, cnhHash])
  @@index([empresaId, validade])
  @@map("motoristas")
}

model HistoricoVeiculo {
  id                 String           @id @default(uuid())
  data_agendada      DateTime // Data agendada da manutenção
  data_conclusao     DateTime? // Data real em que foi realizada
  tipo               String // 'PREVENTIVA', 'CORRETIVA', 'PNEUS', 'OLEO'
  descricao          String?
  pecas_substituidas String?
  custo              Float            @default(0.0)
  km_atual           Float
  status             StatusManutencao @default(PENDENTE)
  origem             String           @default("FUTURA") // 'FUTURA' ou 'ADMINISTRATIVA'

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: Restrict)

  criado_em DateTime @default(now())

  @@index([empresaId, status, data_agendada])
  @@index([empresaId, data_agendada])
  @@index([veiculoId, data_agendada])
  @@index([relatorioArquivoId])
  @@map("historicos_veiculo")
}

model LeituraQuilometragem {
  id            String   @id @default(uuid())
  quilometragem Float
  registrada_em DateTime @default(now())
  origem        String   @default("ATUALIZACAO_VEICULO")

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criado_em DateTime @default(now())

  @@index([empresaId, registrada_em])
  @@index([veiculoId, registrada_em])
  @@map("leituras_quilometragem")
}

model Custo {
  id             String         @id @default(uuid())
  data           DateTime // Data do lançamento
  ano            Int // Ex: 2026
  mesIndex       Int // 0 (Jan) a 11 (Dez)
  semanaIndex    Int // 1 a 4
  categoria      CategoriaCusto
  descricao      String
  valor          Float          @default(0.0)
  formaPagamento String         @default("CARTÃO CORPORATIVO")
  status         StatusCusto    @default(PAGO)

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  motoristaId String?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: Restrict)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, data])
  @@index([veiculoId, data])
  @@index([relatorioArquivoId])
  @@map("custos")
}

// 🔔 SISTEMA GLOBAL DE NOTIFICAÇÕES (Multi-módulo)
model Notificacao {
  id       String  @id @default(uuid())
  modulo   String // Ex: 'FROTA', 'MOTORISTAS', 'CUSTOS'
  titulo   String // Ex: 'Aviso Módulo Frota - Manutenção Pendente'
  mensagem String // Ex: 'Veículo VOLVO FH 540 (ABC-1234) atingiu a data de revisão.'
  lida     Boolean @default(false)

  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarioId String?
  usuario   Usuario? @relation("NotificacoesUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  tarefaId String?
  tarefa   Tarefa? @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  criado_em DateTime @default(now())

  @@index([usuarioId, lida, criado_em])
  @@index([empresaId, lida, criado_em])
  @@map("notificacoes")
}

model Tarefa {
  id         String    @id @default(uuid())
  titulo     String
  descricao  String?
  prazo      DateTime?
  prioridade String    @default("MEDIA")
  status     String    @default("PENDENTE")
  modulo     String?
  origem_id  String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadorId String
  criador   Usuario @relation("TarefasCriadas", fields: [criadorId], references: [id], onDelete: Restrict)

  responsavelId String
  responsavel   Usuario @relation("TarefasResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  notificacoes Notificacao[]

  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt
  concluido_em  DateTime?

  @@index([empresaId, status, prazo])
  @@index([responsavelId, status, prazo])
  @@map("tarefas")
}

model Container {
  id                  String   @id @default(uuid())
  data                DateTime
  codigo              String
  tipo                String
  terminal_inicio     String
  terminal_fim        String
  frete               Float    @default(0)
  comissao            Float    @default(0)
  percentual_comissao Float    @default(10)
  status              String   @default("AGENDADO")
  observacoes         String?
  itens_conteudo      Json?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  motoristaId String?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: Restrict)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@unique([empresaId, codigo, data])
  @@index([empresaId, data, status])
  @@index([relatorioArquivoId])
  @@map("containers")
}

model MovimentacaoContainerPermanente {
  id                  String   @id @default(uuid())
  container_origem_id String   @unique
  codigo_container    String
  terminal_origem     String
  terminal_destino    String
  data_operacao       DateTime

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  relatorioArquivoId String?
  relatorioArquivo   RelatorioArquivo? @relation(fields: [relatorioArquivoId], references: [id], onDelete: SetNull)

  checksum_arquivo     String?
  arquivado_em         DateTime?
  detalhes_purgados_em DateTime?
  criado_em            DateTime  @default(now())
  atualizado_em        DateTime  @updatedAt

  @@index([empresaId, codigo_container])
  @@index([empresaId, data_operacao])
  @@index([relatorioArquivoId])
  @@map("movimentacoes_container_permanentes")
}

model Fatura {
  id             String       @id @default(uuid())
  mes            String // Ex: 'Jun'
  ano            Int // Ex: 2026
  tipo           String // 'IMPLEMENTACAO' ou 'MENSALIDADE'
  valor          Float // Controlado numericamente para permitir overrides no Admin
  status         StatusFatura @default(PENDENTE)
  comprovanteUrl String? // Bucket Privado Supabase Storage

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@index([empresaId, criado_em])
  @@index([status, criado_em])
  @@map("faturas")
}

model RelatorioArquivo {
  id                     String                 @id @default(uuid())
  nome_arquivo           String
  caminho_storage        String                 @unique
  bucket                 String
  mime_type              String
  tamanho_bytes          Int
  checksum_sha256        String
  periodo_inicio         DateTime
  periodo_fim            DateTime
  tipo                   TipoRelatorioArquivo
  status                 StatusRelatorioArquivo @default(PRONTO_DOWNLOAD)
  gerado_automaticamente Boolean                @default(false)
  resumo_registros       Json?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  criadoPorId String?
  criadoPor   Usuario? @relation("RelatoriosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  baixadoPorId String?
  baixadoPor   Usuario?  @relation("RelatoriosBaixados", fields: [baixadoPorId], references: [id], onDelete: SetNull)
  baixado_em   DateTime?

  confirmadoPorId String?
  confirmadoPor   Usuario?  @relation("RelatoriosConfirmados", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  confirmado_em   DateTime?

  dados_purgados_em       DateTime?
  arquivo_removido_em     DateTime?
  movimentacoes_container MovimentacaoContainerPermanente[]
  containers_arquivados   Container[]
  custos_arquivados       Custo[]
  manutencoes_arquivadas  HistoricoVeiculo[]

  criado_em DateTime @default(now())

  @@index([empresaId, criado_em])
  @@index([empresaId, periodo_inicio, periodo_fim])
  @@map("relatorios_arquivados")
}

model RateLimit {
  chaveHash    String   @id @map("chave_hash")
  contador     Int
  janelaInicio DateTime @map("janela_inicio")
  expiraEm     DateTime @map("expira_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([expiraEm])
  @@map("rate_limits")
}

model AuditoriaLog {
  id              String   @id @default(uuid())
  tabela          String
  acao            String
  registroId      String?  @map("registro_id")
  empresaId       String?  @map("empresa_id")
  usuarioId       String?  @map("usuario_id")
  dadosAnteriores Json?    @map("dados_anteriores")
  dadosNovos      Json?    @map("dados_novos")
  origem          String   @default("DATABASE")
  criadoEm        DateTime @default(now()) @map("criado_em")

  @@index([empresaId, criadoEm])
  @@index([tabela, registroId, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("auditoria_logs")
}

model SessaoUsuario {
  id              String    @id @default(uuid())
  usuarioId       String    @map("usuario_id")
  empresaId       String?   @map("empresa_id")
  ipHash          String?   @map("ip_hash")
  userAgent       String?   @map("user_agent")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  ultimaAtividade DateTime  @default(now()) @map("ultima_atividade")
  expiraEm        DateTime  @map("expira_em")
  revogadaEm      DateTime? @map("revogada_em")

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, expiraEm])
  @@index([empresaId, ultimaAtividade])
  @@index([ultimaAtividade, revogadaEm])
  @@map("sessoes_usuario")
}

model EventoSeguranca {
  id        String              @id @default(uuid())
  tipo      EventoSegurancaTipo
  usuarioId String?             @map("usuario_id")
  empresaId String?             @map("empresa_id")
  emailHash String?             @map("email_hash")
  ipHash    String?             @map("ip_hash")
  userAgent String?             @map("user_agent")
  contexto  Json?
  criadoEm  DateTime            @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([tipo, criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([empresaId, criadoEm])
  @@index([ipHash, criadoEm])
  @@map("eventos_seguranca")
}
