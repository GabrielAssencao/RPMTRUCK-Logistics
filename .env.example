# PostgreSQL / Supabase (server only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Privileged server credential (sb_secret_...) - never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_WITH_YOUR_SERVER_SECRET_KEY"

# Internal safety ceiling for private reports (700 MiB reserves room for photos and other Free-tier objects)
RELATORIOS_STORAGE_SOFT_LIMIT_BYTES="734003200"

# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Origens adicionais separadas por vírgula para deploys atrás de proxy/domínios alternativos.
APP_ALLOWED_ORIGINS=""
# Minimum 32 random characters. Existing sessions are invalidated when this value changes.
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_64_IS_RECOMMENDED"
# Opcional, recomendado: separa a pseudonimização de IP/e-mail do segredo de sessão.
RATE_LIMIT_HASH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Cloudflare Turnstile. Ative TURNSTILE_REQUIRED somente depois de configurar as duas chaves.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="localhost,seu-dominio.com.br"
TURNSTILE_REQUIRED="false"

# Criptografia de CPF/CNPJ/CNH/RG/telefones. Cada chave deve ter exatamente 32 bytes em Base64.
# Em instalações novas, mantenha v1. Para rotação, siga o procedimento documentado antes de trocar qualquer valor.
DATA_ENCRYPTION_ACTIVE_VERSION="v1"
DATA_ENCRYPTION_MASTER_KEY=""
DATA_BLIND_INDEX_KEY=""
# Usadas temporariamente durante a rotação v1 -> v2. Remova da hospedagem somente após verificar que não restou enc:v1.
DATA_ENCRYPTION_PREVIOUS_VERSION=""
DATA_ENCRYPTION_PREVIOUS_MASTER_KEY=""
DATA_BLIND_INDEX_PREVIOUS_KEY=""
