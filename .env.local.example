# Copie para .env.local somente depois de criar um projeto Supabase exclusivo
# para desenvolvimento. Nunca reutilize as credenciais de produção.
LOCAL_ENVIRONMENT="development"

# Use temporariamente com npm run local:create-admin e apague a senha depois.
LOCAL_ADMIN_NAME=""
LOCAL_ADMIN_EMAIL=""
LOCAL_ADMIN_PASSWORD=""

DATABASE_URL="postgresql://USER:PASSWORD@DEV_POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DEV_DATABASE_HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_DEVELOPMENT_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_DEVELOPMENT_ANON_KEY"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_WITH_YOUR_DEVELOPMENT_SECRET_KEY"

NEXT_PUBLIC_SITE_URL="http://127.0.0.1:5500"
APP_ALLOWED_ORIGINS="http://127.0.0.1:5500,http://localhost:5500"
JWT_SECRET="REPLACE_WITH_A_LOCAL_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
RATE_LIMIT_HASH_SECRET="REPLACE_WITH_ANOTHER_LOCAL_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
CRON_SECRET="REPLACE_WITH_A_LOCAL_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

TURNSTILE_REQUIRED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="127.0.0.1,localhost"

DATA_ENCRYPTION_ACTIVE_VERSION="v1"
DATA_ENCRYPTION_MASTER_KEY=""
DATA_BLIND_INDEX_KEY=""
# Preencha as três variáveis abaixo somente durante uma rotação sequencial.
DATA_ENCRYPTION_PREVIOUS_VERSION=""
DATA_ENCRYPTION_PREVIOUS_MASTER_KEY=""
DATA_BLIND_INDEX_PREVIOUS_KEY=""
RELATORIOS_STORAGE_SOFT_LIMIT_BYTES="734003200"
PRIVACY_CONTACT_EMAIL=""
ENABLE_SPEED_INSIGHTS="false"
